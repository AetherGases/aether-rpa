# Produção / GitHub Environments (mesmo cluster, bancos distintos)
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_DB_FIRST_YEAR=aether_first_year
POSTGRES_DB=aether_second_year
# Usuário dedicado do RPA no banco do primeiro ano (POSTGRES_DB_FIRST_YEAR)
RPA_POSTGRES_USER=rpa_aether
RPA_POSTGRES_PASSWORD=secret

# Direct (non-pooler) host: LISTEN/NOTIFY does not work through a transaction-mode pooler.
# RPA_DATABASE_A_URL=postgresql://user:password@direct-host:5432/aether_a
# RPA_DATABASE_B_URL=postgresql://user:password@direct-host:5432/aether_b
# DATABASE_A_URL=postgresql://user:password@localhost:5432/aether_a
# DATABASE_B_URL=postgresql://user:password@localhost:5432/aether_b
